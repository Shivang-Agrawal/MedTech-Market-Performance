model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["SourceFilePath", "OurCompanyName", "CompletenessVolumeThreshold", "CompletenessCoverageToleranceDays", "src_Workbook", "stg_VendorRaw", "stg_VendorDedup", "stg_ProductMapping", "stg_CanonicalDescription", "stg_VendorAudit", "_Measures", "FactSales", "DimDate", "DimProduct", "DimFacility", "DimManufacturer", "Top N", "DQ_RowAudit", "DQ_ProductMapping", "DQ_PeriodCompleteness", "ControlTotals", "RefreshInfo", "UserAccess"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table FactSales
ref table DimDate
ref table DimProduct
ref table DimFacility
ref table DimManufacturer
ref table 'Top N'
ref table DQ_RowAudit
ref table DQ_ProductMapping
ref table DQ_PeriodCompleteness
ref table ControlTotals
ref table RefreshInfo
ref table UserAccess

ref role 'Dynamic Facility Access'

